---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Carrent — coming soon">
  <main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(rgb(var(--color-border) / 0.35) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--color-border) / 0.35) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 70% 60% at 50% 45%, black 20%, transparent 75%);"
    >
    </div>

    <a
      href="https://github.com/Onion-L/carrent"
      target="_blank"
      rel="noopener noreferrer"
      class="absolute right-6 top-6 flex items-center gap-2 rounded-md border border-border px-3 py-1.5 font-mono text-xs text-muted transition-colors hover:border-brand hover:text-fg"
    >
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="h-4 w-4">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span>GitHub</span>
    </a>

    <div class="relative flex flex-col items-center text-center">
      <img src="/logo.png" alt="Carrent" class="h-14 w-14" />

      <p
        class="mt-10 font-mono text-[11px] uppercase tracking-[0.35em] text-brand"
      >
        A quiet desktop for coding agents
      </p>

      <h1
        class="mt-4 text-[clamp(3.5rem,10vw,7.5rem)] font-semibold leading-none tracking-[-0.04em]"
      >
        Carrent
      </h1>

      <p class="mt-6 flex items-center gap-2 font-mono text-sm text-muted sm:text-base">
        <span>is coming</span>
        <span class="caret inline-block h-[1.1em] w-[0.55em] translate-y-[0.15em] bg-brand"></span>
      </p>

      <div class="mt-16 flex items-center gap-3 font-mono text-[11px] text-muted/80">
        <span>macOS</span>
        <span aria-hidden="true" class="h-px w-8 bg-border"></span>
        <span>your runtimes</span>
        <span aria-hidden="true" class="h-px w-8 bg-border"></span>
        <span>your projects</span>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .caret {
    animation: blink 1.1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
